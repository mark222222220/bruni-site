{
  "expo": {
    "name": "AVP system",
    "slug": "avp-system",
    "scheme": "avp",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#08080c",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ru.glasshouse.avp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ru.glasshouse.avp",
      "adaptiveIcon": {
        "backgroundColor": "#FF6A1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "AVP system",
      "shortName": "AVP",
      "themeColor": "#0A0A0C",
      "backgroundColor": "#0A0A0C",
      "display": "standalone"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "AVP открывает галерею, чтобы отправить фото в чат команды или приложить накладную.",
          "cameraPermission": "AVP снимает фото для чата команды и накладные при приходе на склад."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "AVP спрашивает Face ID, чтобы цифры завода не увидел посторонний."
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "AVP записывает голосовые сообщения для чата команды."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AVP сканирует QR-наклейки на полках склада и снимает накладные."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "markrrrrrs-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": false
      },
      "eas": {
        "projectId": "13d79515-d757-4586-b342-02cd975981b3"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/13d79515-d757-4586-b342-02cd975981b3"
    }
  }
}
